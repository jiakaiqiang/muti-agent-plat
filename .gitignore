# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build outputs
dist/
build/
coverage/
.turbo/
.vite/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
.tmp-dev-logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
.cache/
.codex-run/
.playwright-cli/
output/
.tmp/
tmp/
temp/
uploads/
artifacts/
# The server artifact module is source code, not generated output.
!apps/server/src/modules/artifacts/
!apps/server/src/modules/artifacts/**

# Docker and database local state
*.pid
*.seed
dump.sql
*.dump
*.backup.sql
agent_cluster_backup.sql
db-export/

# AgentRoom runtime state (sessions/worktrees/probes) — never commit
.agentroom/

# WorkBuddy tool local memory/state — never commit
.workbuddy/

# IDE and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test reports
playwright-report/
test-results/
junit.xml

# Stray local scratch files
.tmpdir.txt

# Raw model provider/transport dumps from intent evaluations (large; reports and summaries stay tracked)
docs/quality/**/provider-*.json
docs/quality/**/provider-*.jsonl
docs/quality/**/transport-*.json
