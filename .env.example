# Runtime mode
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
TZ=Asia/Shanghai

# Frontend
WEB_HOST=0.0.0.0
WEB_PORT=5173
VITE_APP_NAME=Agent Cluster
VITE_API_BASE_URL=http://127.0.0.1:3000/api
VITE_SSE_BASE_URL=http://127.0.0.1:3000/api
VITE_ENABLE_MOCKS=false
VITE_AGENT_CLUSTER_COMMIT=

# Backend
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api
AGENT_CLUSTER_PERSISTENCE=true
AGENT_CLUSTER_PERSISTENCE_BACKEND=postgres
AGENT_CLUSTER_DATA_DIR=.cache/agent-cluster
AGENT_CLUSTER_DATA_FILE=
AGENT_CLUSTER_CONTENT_DIR=.cache/agent-cluster/content-store
AGENT_CLUSTER_INLINE_OUTPUT_MAX_BYTES=65536
AGENT_CLUSTER_SEED_DEFAULT_AGENTS=false
AGENT_CLUSTER_RECOVER_ON_BOOT=true
AGENT_CLUSTER_MAINTENANCE_MODE=false
AGENT_CLUSTER_COMMIT=
AGENT_CLUSTER_BUILD_TIME=
AGENT_CLUSTER_CUTOVER_ENVIRONMENT=local
AGENT_CLUSTER_CUTOVER_TOKEN_SECRET=
AGENT_CLUSTER_CUTOVER_OPERATOR=
AGENT_CLUSTER_CUTOVER_QUIESCED=false
AGENT_CLUSTER_CUTOVER_ARCHIVE_DIR=
AGENT_CLUSTER_CUTOVER_ARCHIVE_KEY=
AGENT_CLUSTER_MAINTENANCE_TOKEN=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_cluster
POSTGRES_USER=agent_cluster
POSTGRES_PASSWORD=agent_cluster_dev
DATABASE_URL=postgresql://agent_cluster:agent_cluster_dev@localhost:5432/agent_cluster
DATABASE_SSL=false
DATABASE_LOGGING=true
AGENT_CLUSTER_POSTGRES_COLLECTION_TABLE=agent_cluster_collections

# Redis and BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
ENABLE_BULLMQ=true
BULLMQ_PREFIX=agent-cluster
REDIS_CONNECT_TIMEOUT_MS=5000
QUEUE_ATTEMPTS=3
QUEUE_CONCURRENCY=4

# LLM runtime defaults
GLOBAL_DEFAULT_RUNTIME_TYPE=generic_llm
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_MODEL_OPTIONS=llama3.2,qwen2.5,mistral,deepseek-r1
LLM_API_KEY=
# Required when adding or updating persisted Runtime model credentials.
# Generate a high-entropy deployment secret and keep it outside the repository.
AGENT_CLUSTER_SECRET_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_MODE=auto
LLM_SCHEMA_REPAIR_ATTEMPTS=1
LLM_DIAGNOSTIC_PREVIEW_CHARS=512
LLM_DRY_RUN=false
LLM_MOCK_FALLBACK=false

# OpenAI-compatible cloud example:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4.1-mini
# LLM_MODEL_OPTIONS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-4o
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# Mock runtime
MOCK_RUNTIME_ENABLED=false
MOCK_RUNTIME_DELAY_MS=300
MOCK_RUNTIME_FAILURE_RATE=0

# Multi-agent discussion
DISCUSSION_AGENT_KEYS=requirements,architect,backend,test
DISCUSSION_MAX_ROUNDS=1
# 0 delegates timeout handling to each runtime's watchdog. Set a positive value
# only when discussion needs a stricter phase-level deadline.
DISCUSSION_TIMEOUT_MS=0
# Per-phase deadlines override the legacy discussion key. Zero disables the
# phase deadline and leaves timeout ownership to the selected runtime watchdog.
PHASE_TIMEOUT_DISCUSSION_MS=0
# PHASE_TIMEOUT_BRIEF_GENERATION_MS=0
# PHASE_TIMEOUT_BRIEF_REVISION_MS=0
# PHASE_TIMEOUT_TASK_ACCEPTANCE_MS=0
# Task execution has no native watchdog in buffered claude_code / browser-mirror
# paths, so a stalled prepare or child process would hang the workflow node
# forever. Keep a phase-level deadline as the last-resort backstop.
PHASE_TIMEOUT_TASK_EXECUTION_MS=600000
# PHASE_TIMEOUT_POST_REVIEW_MS=0
# PHASE_TIMEOUT_FINAL_DELIVERY_MS=0
# PHASE_TIMEOUT_USER_MESSAGE_ROUTING_MS=0

# Grace period for structured service_shutdown propagation before process exit.
SHUTDOWN_EXECUTION_GRACE_MS=10000

# Explicit local mock mode for demos/tests:
# VITE_ENABLE_MOCKS=true
# GLOBAL_DEFAULT_RUNTIME_TYPE=mock
# LLM_MOCK_FALLBACK=true
# MOCK_RUNTIME_ENABLED=true

# RAG and embeddings
RAG_ENABLED=true
RAG_MOCK_EMBEDDINGS=false
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=local-keyword-search
RAG_TOP_K=6
RAG_MIN_SCORE=0.5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# Memory and token budget
MEMORY_ENABLED=true
TOKEN_BUDGET_DEFAULT=100000
TOKEN_ACCOUNTING_MODE=estimated
LLM_INPUT_SAFETY_MARGIN_RATIO=0.1

# Engineering Runtime and connector placeholders
CODEX_RUNTIME_ENABLED=false
CLAUDE_CODE_ENABLED=false
RUNTIME_STREAMING=off
VITE_DEFAULT_SERVER_WORKSPACE_PATH=
AGENT_CLUSTER_BROWSER_MIRROR_MAX_FILES=512
AGENT_CLUSTER_BROWSER_MIRROR_MAX_TOTAL_BYTES=16777216
AGENT_CLUSTER_BROWSER_MIRROR_MAX_FILE_BYTES=2097152
AGENT_CLUSTER_BROWSER_MIRROR_MAX_DEPTH=32
# Overall watchdog for browser-mirror preparation. 0 disables it; lower layers
# (broker requests, git commands) also have their own timeouts.
BROWSER_MIRROR_PREPARE_TIMEOUT_MS=300000
# Per-git-command timeout for worktree/mirror operations. 0 disables it.
AGENT_CLUSTER_WORKTREE_GIT_TIMEOUT_MS=120000
CODEX_RUNTIME_TIMEOUT_MS=600000
# Claude buffered mode: 0 or unset disables the absolute deadline; positive values are milliseconds.
CLAUDE_CODE_TIMEOUT_MS=0
CODEX_RUNTIME_FIRST_FRAME_TIMEOUT_MS=30000
CODEX_RUNTIME_IDLE_TIMEOUT_MS=600000
CODEX_RUNTIME_ABSOLUTE_TIMEOUT_MS=
CLAUDE_CODE_FIRST_FRAME_TIMEOUT_MS=30000
CLAUDE_CODE_IDLE_TIMEOUT_MS=600000
CLAUDE_CODE_ABSOLUTE_TIMEOUT_MS=
# Provider failures are retried once by default, then the Runtime circuit opens and
# routing may continue only with a Runtime explicitly allowed by the Session.
RUNTIME_PROVIDER_MAX_ATTEMPTS=3
RUNTIME_PROVIDER_RETRY_MAX_DELAY_MS=120000
RUNTIME_PROVIDER_CIRCUIT_TTL_MS=120000
MCP_RUNTIME_ENABLED=false
FEISHU_MOCK_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

# Local development safety
ENABLE_HIGH_RISK_TOOLS=false
REQUIRE_USER_CONFIRMATION=true
ALLOW_FILE_WRITE_RUNTIME=false
ALLOW_COMMAND_RUNTIME=false
