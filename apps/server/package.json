{
  "name": "@agent-cluster/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-entry.mjs",
    "start": "node dist/apps/server/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-unit-tests.mjs && node --test scripts/dev-build-cache.spec.mjs scripts/dev-server-guard.spec.mjs scripts/dev-restart-control.spec.mjs",
    "test:workspace-index-first": "tsx --test --tsconfig tsconfig.json src/common/api-exception.filter.spec.ts src/common/workspace-metrics.spec.ts src/modules/sessions/sessions.service.spec.ts src/modules/context-v2/build-envelope-from-context-assembly.spec.ts src/modules/orchestrator/context-router.service.spec.ts src/modules/orchestrator/orchestrator.service.spec.ts src/modules/orchestrator/project-map.service.spec.ts src/modules/orchestrator/supplemental-context-dedupe.spec.ts src/modules/orchestrator/supplemental-context-retry.spec.ts src/modules/runtimes/runtime.service.spec.ts src/modules/tools/builtin/code-search.tool.spec.ts src/modules/workspaces/server-local-workspace-index.spec.ts src/modules/workspaces/workspace-list-directory.spec.ts src/modules/workspaces/workspace-search-text.spec.ts src/modules/workspaces/workspace-read-file.spec.ts src/modules/workspaces/workspace-path.spec.ts src/modules/workspaces/workspace-sensitive-guard.spec.ts src/modules/workspaces/workspace-symlink-guard.spec.ts",
    "test:perf:workspace-session-create": "tsx --tsconfig tsconfig.json scripts/workspace-session-create.performance.ts"
  },
  "dependencies": {
    "@agent-cluster/shared": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "ajv": "^8.17.1",
    "bullmq": "^5.77.6",
    "ioredis": "^5.11.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
