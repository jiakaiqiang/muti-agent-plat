    "pack": "node scripts/package.mjs",
    "pack:release": "node scripts/package.mjs --release"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": {
    "vue": "^3.5.13",
    "pinia": "^2.3.0",
    "vue-router": "^4.6.3",
    "element-plus": "^2.14.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-flow/core": "^1.48.2",
    "@lucide/vue": "^1.16.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
