{
  "name": "@agent-cluster/desktop",
  "productName": "Agent Cluster",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Cluster desktop workspace",
  "author": "Agent Cluster",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
